
{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": ".",
    "declaration": false,
    "sourceMap": false
  },
  "include": ["app.ts", "model.ts"],
  "exclude": ["node_modules"]
}
